# Copy this file to `.env` in the repository root and fill in the values.
#
#   D:\Data analysis\Propaganda Dashboard2\.env
#
# `.env` is gitignored (.gitignore lines 2-3) and this harness additionally denies reading it
# (settings.json), so the keys never enter git and I never see them.
#
# Nothing reads these variables yet: the LLM gateway is SPEC-005 and is not implemented. Until it
# exists these lines are inert — they are the agreed contract, written down before the code so the
# names do not drift later.
#
# Both keys are required, not redundant. D-010: the benchmark chooses the primary provider, but the
# validator must always be a *different vendor* — two models from one vendor share blind spots and
# agreement between them is not evidence.

DEEPSEEK_API_KEY=

GEMINI_API_KEY=

# Optional overrides; the defaults are what the code will use.
# GTAF_LLM_PRIMARY=deepseek
# GTAF_MONTHLY_BUDGET_USD=20
